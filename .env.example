# Copy this file to .env and fill it in. Never commit .env.

# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Leave empty on your laptop to use a local file database (itfy.db).
# On Vercel: your MongoDB Atlas connection string, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/itfy
DATABASE_URI=

# Only needed on Vercel (Storage > Blob creates it for you). Leave empty on your laptop.
BLOB_READ_WRITE_TOKEN=
